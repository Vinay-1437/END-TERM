PORT=5000
NODE_ENV=production
# MongoDB connection URI (e.g., from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart-campus?retryWrites=true&w=majority

# Secret key for signing JWT tokens (generate a long random string)
JWT_SECRET=your_jwt_secret_key_here

# Client URL for CORS (your Vercel frontend URL)
CLIENT_URL=https://your-frontend-project.vercel.app

# Cloudinary configuration (optional, for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
